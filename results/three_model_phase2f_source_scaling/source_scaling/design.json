      "m5"
    ]
  },
  "target_rationale": {
    "LOOP_SEATTLE_5T": {
      "frequency": "5min",
      "seasonal_period": 288,
      "domain_family": "transport",
      "provenance": "held_out",
      "signal": "freeway loop-detector speeds: smooth, strongly daily-periodic",
      "why": "the only 5-minute dataset; held out from Chronos-2 pretraining (fev-bench)"
    },
    "monash_london_smart_meters": {
      "frequency": "30min",
      "seasonal_period": 48,
      "domain_family": "energy",
      "provenance": "listed",
      "signal": "single-household electricity use: noisy and spiky",
      "why": "the only 30-minute dataset; documented pretraining data; same domain family as the two Electricity sources (a near-domain target)"
    },
    "boom_hourly": {
      "frequency": "1H",
      "seasonal_period": 24,
      "domain_family": "cloud",
      "provenance": "not_listed",
      "signal": "cloud observability metrics: the lowest dynamic range in the roster, many flat stretches (Phase-1 yield screen: 12% constant future windows)",
      "why": "the hourly slot must be 'not listed' (only hourly datasets are), and SG Carpark would repeat Loop Seattle's transport family"
    },
    "m5": {
      "frequency": "1D",
      "seasonal_period": 7,
      "domain_family": "retail",
      "provenance": "held_out",
      "signal": "daily retail unit sales: intermittent low counts",
      "why": "daily slot; held out from Chronos-2 pretraining (Benchmark II, fev-bench); preferred to Wiki Daily (listed) by R4"
    }
  },
