  "target_selection": {
    "rule": "Applied to dataset metadata only (sampling frequency, domain family, Chronos-2 pretraining provenance, number of test series), never to any transfer or truncation result. R1: no Electricity dataset (series siblings), so every target's source pool is all 13 other datasets, as in the Phase 2c main protocol. R2: the test split reaches the full 262-series budget (excludes SZ Taxi, 156 series, and Coastal T-S, 24), so every target has comparable statistical power. R3: four distinct sampling frequencies, all three provenance groups (held out / not listed / listed), four distinct domain families. R4: ties go to more targets held out from Chronos-2 pretraining (the strictest zero-shot case: unseen by the backbone and by the adapter), then to roster order.",
    "excluded_R1_series_siblings": [
      "monash_electricity_hourly",
      "electricity_15min"
    ],
    "excluded_R2_test_series_below_budget": {
      "coastal_ts": 24,
      "SZ_TAXI_15T": 156
    },
    "admissible_sets": [
      [
        "boom_hourly",
        "LOOP_SEATTLE_5T",
        "monash_london_smart_meters",
        "m5"
      ],
      [
