  },
  "causality_note": "TimesFM-3 (causal attention) and TiRex (causal recurrence): content token j has seen only patches <= j, so the content mean mixes states conditioned on truncated history; only the last token has seen all 512 points. Chronos-2's encoder is bidirectional: every content token sees the whole context (and the forecast-slot placeholders, which carry no values).",
  "decomposition": [
    {
      "step": "readout_structure",
      "from": "native",
      "to": "concat",
      "what_changes": "same token states; native patch-shared head -> one unshared full-horizon head"
    },
    {
      "step": "pooling",
      "from": "concat",
      "to": "native_mean",
      "what_changes": "same tokens and head form; K readout states concatenated -> averaged. NOT pure pooling: the input shrinks K*d -> d, so the readout capacity also drops K-fold"
    },
    {
      "step": "token_selection",
      "from": "native_mean",
      "to": "pooled",
      "what_changes": "same head and parameter count; native readout tokens -> mean of content tokens. The cleanest comparison: only the choice of tokens changes"
    },
    {
      "step": "representation",
      "from": "native",
      "to": "pooled",
      "what_changes": "TimesFM-3 only: same head and parameter count; token 15 -> mean of tokens 0..15"
    }
